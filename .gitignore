# makepkg working directories and output. Anchored per-package rather than
# globally: there are two PKGBUILDs now, one at the root and one under
# desktop-themes/, and each grows its own src/ and pkg/ where it is built.
/src/
/pkg/
/desktop-themes/src/
/desktop-themes/pkg/
*.pkg.tar.*
*.log

# generated theme assets (build-theme.py regenerates all 206 files)
/theme/
/tools/plyparse
/tools/plyrun

# python bytecode from importing the generator
__pycache__/
*.pyc

# build output of build-limine.py when run in the repo root
/limine/

# AUR flavour is generated by aur/sync.sh from the canonical PKGBUILD, but the
# result IS tracked -- only the scratch copy of the scriptlet it makes is not
/aur/omarchy-plymouth-nier.install
