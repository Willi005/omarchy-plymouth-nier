#!/bin/bash
# Make GTK4/libadwaita apps follow the active theme's palette.
#
# Omarchy does not theme GTK apps from the palette. omarchy-theme-set-gnome
# sets exactly three things: color-scheme and gtk-theme to a hardcoded Adwaita
# or Adwaita-dark from the theme's `mode`, and icon-theme from its
# icons.theme. So a file manager under any Omarchy theme is stock GNOME in
# light or dark, and the only colour the theme picks there is the folder icon.
#
# libadwaita ignores gtk-theme entirely; overriding its named colours in
# ~/.config/gtk-4.0/gtk.css is the supported way to recolour it. This hook
# installs the gtk.css a theme ships, and removes it again for a theme that
# ships none -- otherwise one theme's colours would leak into every theme
# chosen afterwards, which is the same failure mode as a config another
# package owns.
#
# Deliberately keyed on the file, not on a theme name: any theme that ships a
# gtk.css gets this, ours or anyone else's.
#
# GTK3 apps do not read these names and stay Adwaita. Apps read gtk.css at
# startup, so a running file manager keeps the old colours until reopened.
#
# $1 is the theme's slug.

set -u

STAGED="$HOME/.local/state/omarchy/current/theme/gtk.css"
TARGET="${XDG_CONFIG_HOME:-$HOME/.config}/gtk-4.0/gtk.css"
MARKER="generated by build-gtk.py"

# Never touch a gtk.css this hook did not write. Somebody's hand-written GTK
# customisation is not ours to replace or delete.
if [[ -f $TARGET ]] && ! grep -qF "$MARKER" "$TARGET"; then
    exit 0
fi

if [[ -f $STAGED ]]; then
    mkdir -p "${TARGET%/*}"
    cp "$STAGED" "$TARGET"
else
    rm -f "$TARGET"
fi
