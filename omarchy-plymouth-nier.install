_theme=omarchy-minimal
_stock=omarchy
_conf=/etc/plymouth/plymouthd.conf

# DeviceScale=1 is not cosmetic. Plymouth guesses a HiDPI device scale from
# DPI = width*254/(10*(width_mm+1)) and picks 2 above 96 DPI. On a 2880x1800
# 310x200mm panel that is 235 DPI, so it would halve the logical window to
# 1440x900 and upscale every image 2x with the same nearest-neighbour sampler
# used by Image.Scale -- the whole composition twice its intended size and
# visibly destroyed. plymouthd reads no conf.d, and this file belongs to the
# plymouth package, so it is edited in place here rather than shipped.
_ensure_device_scale() {
    if [ ! -f "$_conf" ]; then
        printf '[Daemon]\nDeviceScale=1\n' > "$_conf"
        return
    fi
    if grep -q '^[[:space:]]*DeviceScale[[:space:]]*=' "$_conf"; then
        sed -i 's/^[[:space:]]*DeviceScale[[:space:]]*=.*/DeviceScale=1/' "$_conf"
    elif grep -q '^\[Daemon\]' "$_conf"; then
        sed -i '0,/^\[Daemon\]/s//[Daemon]\nDeviceScale=1/' "$_conf"
    else
        printf '[Daemon]\nDeviceScale=1\n' >> "$_conf"
    fi
}

# How the boot image is rebuilt depends on the bootloader setup, and getting
# this wrong leaves the theme installed but never shown.
#
# On a Limine + Unified Kernel Image system there are no mkinitcpio presets at
# all: /etc/mkinitcpio.d is empty and `mkinitcpio -P` fails outright with "No
# presets found". Worse, the mkinitcpio on PATH there is an interactive
# wrapper from limine-mkinitcpio-hook that prompts before doing anything --
# never acceptable from a scriptlet -- and a scriptlet's PATH does not include
# /usr/local/bin anyway, so it would silently hit the real binary and fail.
_rebuild_boot_image() {
    if [ -x /usr/bin/limine-mkinitcpio ]; then
        echo ":: rebuilding the boot image (limine-mkinitcpio)..."
        /usr/bin/limine-mkinitcpio
    elif ls /etc/mkinitcpio.d/*.preset >/dev/null 2>&1; then
        echo ":: rebuilding the boot image (mkinitcpio -P)..."
        /usr/bin/mkinitcpio -P
    else
        cat <<'WARN'
:: WARNING: could not work out how to rebuild the boot image.
::          The theme is installed and set as the default, but the passphrase
::          prompt will keep using the old one until the initramfs is
::          regenerated. Run whatever your bootloader needs.
WARN
    fi
}

# ---------------------------------------------------------------------------
# Limine boot menu
#
# The bootloader menu is the last screen in the chain still wearing Omarchy's
# stock Tokyo Night palette, and it shows immediately before the Plymouth LUKS
# prompt, so the mismatch reads as a hard cut. Limine needs no initramfs
# rebuild -- it reads limine.conf at boot -- but the file lives on the ESP and
# is shared with limine-entry-tool, so only the global header above the first
# entry is ever touched.
#
# The splice itself lives in a file the package installs, so the scriptlet,
# install.sh and omarchy-nier-reconfigure all run the same code.
_share=/usr/share/omarchy-plymouth-nier/limine
_splice=/usr/share/omarchy-plymouth-nier/limine-splice.sh

# shellcheck source=/dev/null
[ -r "$_splice" ] && . "$_splice"

# A prebuilt package carries artwork rasterised for one panel, and Plymouth's
# only scaler is nearest-neighbour, so on a different screen it looks wrong.
# When that happens and the optional tools are present, regenerate on the spot;
# omarchy-nier-reconfigure does the whole job, so _activate skips its own work.
_panel() {
    awk 'FNR == 1 && /^[0-9]+x[0-9]+$/ {
             split($0, d, "x")
             if (d[1] * d[2] > best) { best = d[1] * d[2]; mode = $0 }
         }
         END { print mode }' /sys/class/drm/*/modes 2>/dev/null
}

_regenerated_for_this_display() {
    [ -x /usr/bin/omarchy-nier-reconfigure ] || return 1
    local built panel
    built=$(cat /usr/share/omarchy-plymouth-nier/built-for 2>/dev/null || true)
    panel=$(_panel)
    [ -n "$panel" ] && [ "$built" = "$panel" ] && return 1

    echo ":: artwork was rendered for ${built:-an unknown screen}; this display is ${panel:-unknown}"
    if /usr/bin/omarchy-nier-reconfigure; then
        return 0
    fi
    cat <<'WARN'
:: WARNING: could not regenerate for this display. The theme still works, but
::          the artwork is sized for another screen and Plymouth cannot scale
::          it cleanly. Install the optional dependencies, then run:
::              sudo omarchy-nier-reconfigure
WARN
    return 1
}

_activate() {
    _ensure_device_scale
    _regenerated_for_this_display && return 0
    plymouth-set-default-theme "$_theme"
    _rebuild_boot_image
    _apply_limine
}

post_install() {
    _activate
    cat <<'MSG'

  Installed. To change anything -- the palette, how many glyphs, the name,
  the boot menu branding -- edit the config and re-run the generator:

      sudo $EDITOR /etc/omarchy-plymouth-nier.conf
      sudo omarchy-nier-reconfigure          # --dry-run to preview

  That file is yours: pacman preserves it across upgrades and leaves a
  .pacnew when the defaults change. Reconfiguring needs the optional
  dependencies (imagemagick and the two font packages).

  The Limine boot menu was themed too. Its stock header is kept at
  <esp>/limine.conf.omarchy-nier.bak, and boot entries were not touched.

  Roll back to the stock Omarchy screens with:
      sudo plymouth-set-default-theme omarchy
  followed by your bootloader's initramfs rebuild. Removing this package
  does all of it for you, boot menu included.

MSG
}

post_upgrade() {
    _activate
}

pre_remove() {
    # Hand both screens back to stock before the files vanish.
    _revert_limine || true
    plymouth-set-default-theme "$_stock" || true
}

post_remove() {
    _rebuild_boot_image || true
}
